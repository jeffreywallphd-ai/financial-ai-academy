      "turns": [
        {"command_id": "portfolio-allocate", "outcome": "succeeded", "code": "portfolio.allocation-projected", "remediation_count": 0},
        {"command_id": "portfolio-allocate", "outcome": "succeeded", "code": "portfolio.allocation-projected", "remediation_count": 0}
      ],
      "assertions": {"max_turns": 2, "max_aggregate_readiness": 0, "required_commands": ["portfolio-allocate"], "forbidden_commands": ["request-approval", "manual-metadata-edit"], "expected_final_code": "portfolio.allocation-projected"}
    },
    {
      "id": "review-corrected-descendant",
      "turns": [
        {"command_id": "record-review", "outcome": "not-ready", "code": "review.changes-requested", "remediation_count": 1},
        {"command_id": "resubmit", "outcome": "succeeded", "code": "review.corrected-descendant-submitted", "remediation_count": 0},
        {"command_id": "verify", "outcome": "succeeded", "code": "verification.receipt-recorded", "remediation_count": 0},
        {"command_id": "record-review", "outcome": "succeeded", "code": "review.recorded", "remediation_count": 0}
