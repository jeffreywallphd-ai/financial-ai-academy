{
  "schema_version": "harness-corpus-v1",
  "scenarios": [
    {
      "id": "completed-correction-short-route",
      "turns": [
        {"command_id": "correction-route", "outcome": "succeeded", "code": "correction.route-planned", "remediation_count": 0},
        {"command_id": "author-bounded-descendant-wrk", "outcome": "succeeded", "code": "planning.packet-ready", "remediation_count": 0},
        {"command_id": "claim", "outcome": "succeeded", "code": "lifecycle.claimed", "remediation_count": 0}
      ],
      "assertions": {"max_turns": 3, "max_aggregate_readiness": 0, "required_commands": ["correction-route"], "forbidden_commands": ["request-approval", "manual-metadata-edit"], "expected_final_code": "lifecycle.claimed"}
    },
    {
      "id": "confinement-path-denial",
      "turns": [
        {"command_id": "verify", "outcome": "refused", "code": "capability.path-denied", "remediation_count": 1}
