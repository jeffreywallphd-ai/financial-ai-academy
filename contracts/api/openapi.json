  "info": {
    "title": "Financial AI Academy API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/curriculum/placements/{placement_id}/lesson": {
      "get": {
        "operationId": "getPlacedLesson",
        "parameters": [
          {
            "in": "path",
            "name": "placement_id",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "title": "Placement Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonReadingResponseModel"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
