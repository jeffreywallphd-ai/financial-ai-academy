{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.local/contracts/learning/learner-preferences/v1/export.schema.json",
  "title": "Learner preference export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "limitations", "exported_at", "profile", "history"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 240},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 320}},
    "exported_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "profile": {"type": "object"},
    "history": {"type": "object"}
  }
}
