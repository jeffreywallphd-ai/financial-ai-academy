{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/learner-model/practice/v1/history.schema.json",
  "title": "Rebuildable practice attempt history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "placement_id", "package_id", "package_version", "package_digest", "definition_digest", "practice_id", "practice_version", "attempt_policy_id", "attempt_policy_version", "source_digest", "attempts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "placement_id": {"$ref": "#/$defs/id"}, "package_id": {"$ref": "#/$defs/id"},
    "package_version": {"$ref": "#/$defs/version"}, "package_digest": {"$ref": "#/$defs/digest"},
    "definition_digest": {"$ref": "#/$defs/digest"}, "practice_id": {"$ref": "#/$defs/id"},
    "practice_version": {"const": "1.0.0"}, "attempt_policy_id": {"const": "formative-retry"},
    "attempt_policy_version": {"const": "1.0.0"}, "source_digest": {"$ref": "#/$defs/digest"},
    "attempts": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/attempt"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "uuid": {"type": "string", "format": "uuid"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "utcDateTime": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "itemSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "item_version", "item_type", "scoring_policy_id", "scoring_policy_version", "score", "max_score", "correct", "review_reference_ids"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"}, "item_version": {"const": "1.0.0"},
        "item_type": {"enum": ["single_select", "multiple_select", "numeric_entry"]},
        "scoring_policy_id": {"enum": ["single-select-exact-match", "multiple-select-exact-set", "numeric-exact-or-inclusive-range"]},
        "scoring_policy_version": {"const": "1.0.0"}, "score": {"type": "integer", "minimum": 0, "maximum": 1},
        "max_score": {"const": 1}, "correct": {"type": "boolean"},
        "review_reference_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_order", "event_id", "attempt_id", "evidence_id", "submission_id", "score", "max_score", "outcome", "item_summaries", "completed_at"],
      "properties": {
        "attempt_order": {"type": "integer", "minimum": 1, "maximum": 10},
        "event_id": {"$ref": "#/$defs/uuid"}, "attempt_id": {"$ref": "#/$defs/uuid"},
        "evidence_id": {"$ref": "#/$defs/uuid"}, "submission_id": {"$ref": "#/$defs/uuid"},
        "score": {"type": "integer", "minimum": 0, "maximum": 20},
        "max_score": {"type": "integer", "minimum": 1, "maximum": 20},
        "outcome": {"enum": ["all_correct", "review_needed"]},
        "item_summaries": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/itemSummary"}},
        "completed_at": {"$ref": "#/$defs/utcDateTime"}
      }
    }
  }
}
