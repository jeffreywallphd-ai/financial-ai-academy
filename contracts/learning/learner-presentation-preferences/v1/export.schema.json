{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.local/contracts/learning/learner-presentation-preferences/v1/export.schema.json",
  "title": "Learner presentation preference export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "limitations", "exported_at", "profile", "history"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 240},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 320}},
    "exported_at": {"$ref": "#/$defs/time"},
    "profile": {"$ref": "#/$defs/profile"},
    "history": {"$ref": "#/$defs/history"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile_id", "learner_id", "revision", "text_size", "text_spacing", "reading_width", "motion", "created_at", "updated_at", "profile_digest"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "profile_id": {"$ref": "#/$defs/id"},
        "learner_id": {"type": "string", "format": "uuid"},
        "revision": {"type": "integer", "minimum": 1},
        "text_size": {"enum": ["default", "larger"]},
        "text_spacing": {"enum": ["default", "increased"]},
        "reading_width": {"enum": ["standard", "focused"]},
        "motion": {"enum": ["system", "reduce"]},
        "created_at": {"$ref": "#/$defs/time"},
        "updated_at": {"$ref": "#/$defs/time"},
        "profile_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "revision", "operation", "object_kind", "object_id", "occurred_at", "resulting_profile_digest"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "revision": {"type": "integer", "minimum": 1},
        "operation": {"enum": ["replace_preferences", "reset_profile"]},
        "object_kind": {"const": "profile"},
        "object_id": {"type": "null"},
        "occurred_at": {"$ref": "#/$defs/time"},
        "resulting_profile_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile_id", "current_revision", "changes"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "profile_id": {"$ref": "#/$defs/id"},
        "current_revision": {"type": "integer", "minimum": 1},
        "changes": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/change"}}
      }
    }
  }
}
