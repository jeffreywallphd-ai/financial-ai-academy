{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.local/contracts/learning/personal-workspace/v1/workspace.schema.json",
  "title": "Personal Workspace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "learner_id", "revision", "records", "collections", "created_at", "updated_at", "workspace_digest"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "workspace_id": { "$ref": "#/$defs/platform_identifier" },
    "learner_id": { "$ref": "#/$defs/platform_identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "records": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/record" } },
    "collections": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/collection" } },
    "created_at": { "$ref": "#/$defs/utc_time" },
    "updated_at": { "$ref": "#/$defs/utc_time" },
    "workspace_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "platform_identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "curriculum_identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc_time": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\u0000]*$" },
    "learner_title": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000]*$" },
    "note_body": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "^[^\\u0000]*$" },
    "destination": { "type": "string", "pattern": "^/learn/placements/[a-z0-9][a-z0-9._-]{2,63}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published_by", "published_at", "content_reviewed_on", "educational_use_notice"],
      "properties": {
        "published_by": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000]*$" },
        "published_at": { "$ref": "#/$defs/utc_time" },
        "content_reviewed_on": { "type": "string", "format": "date" },
        "educational_use_notice": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000]*$" }
      }
    },
    "learning_opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_kind", "owner_module", "opportunity_id", "placement_id", "package_id", "package_version", "package_digest", "source_fingerprint", "title", "destination", "target_status", "provenance", "validated_at"],
      "properties": {
        "reference_kind": { "const": "learning_opportunity" },
        "owner_module": { "const": "curriculum" },
        "opportunity_id": { "$ref": "#/$defs/curriculum_identifier" },
        "placement_id": { "$ref": "#/$defs/curriculum_identifier" },
        "package_id": { "$ref": "#/$defs/curriculum_identifier" },
        "package_version": { "$ref": "#/$defs/version" },
        "package_digest": { "$ref": "#/$defs/digest" },
        "source_fingerprint": { "$ref": "#/$defs/digest" },
        "title": { "$ref": "#/$defs/title" },
        "destination": { "$ref": "#/$defs/destination" },
        "target_status": { "const": "available" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "validated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "placed_lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_kind", "owner_module", "placement_id", "package_id", "package_version", "package_digest", "title", "destination", "target_status", "provenance", "validated_at"],
      "properties": {
        "reference_kind": { "const": "placed_lesson" },
        "owner_module": { "const": "curriculum" },
        "placement_id": { "$ref": "#/$defs/curriculum_identifier" },
        "package_id": { "$ref": "#/$defs/curriculum_identifier" },
        "package_version": { "$ref": "#/$defs/version" },
        "package_digest": { "$ref": "#/$defs/digest" },
        "title": { "$ref": "#/$defs/title" },
        "destination": { "$ref": "#/$defs/destination" },
        "target_status": { "const": "available" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "validated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "project_workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_kind", "owner_module", "project_id", "title", "lifecycle", "project_revision", "workspace_revision", "destination", "target_status", "validated_at"],
      "properties": {
        "reference_kind": { "const": "project_workspace" }, "owner_module": { "const": "project" },
        "project_id": { "$ref": "#/$defs/platform_identifier" }, "title": { "$ref": "#/$defs/title" },
        "lifecycle": { "const": "active" }, "project_revision": { "type": "integer", "minimum": 1 },
        "workspace_revision": { "type": "integer", "minimum": 1 },
        "destination": { "type": "string", "pattern": "^/projects/[a-z0-9][a-z0-9._-]{0,127}#workspace$" },
        "target_status": { "const": "available" }, "validated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "project_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_kind", "owner_module", "project_id", "snapshot_id", "title", "lifecycle", "project_revision", "workspace_revision", "snapshot_digest", "closed_at", "destination", "target_status", "validated_at"],
      "properties": {
        "reference_kind": { "const": "project_snapshot" }, "owner_module": { "const": "project" },
        "project_id": { "$ref": "#/$defs/platform_identifier" }, "snapshot_id": { "$ref": "#/$defs/platform_identifier" },
        "title": { "$ref": "#/$defs/title" }, "lifecycle": { "const": "active" },
        "project_revision": { "type": "integer", "minimum": 1 }, "workspace_revision": { "type": "integer", "minimum": 1 },
        "snapshot_digest": { "$ref": "#/$defs/digest" }, "closed_at": { "$ref": "#/$defs/utc_time" },
        "destination": { "type": "string", "pattern": "^/projects/[a-z0-9][a-z0-9._-]{0,127}#snapshot-[a-z0-9][a-z0-9._-]{0,127}$" },
        "target_status": { "const": "available" }, "validated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "project_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_kind", "owner_module", "project_id", "artifact_id", "artifact_version", "title", "lifecycle", "project_revision", "workspace_revision", "artifact_kind", "logical_path", "media_type", "inspection_mode", "byte_count", "content_digest", "created_at", "destination", "target_status", "validated_at"],
      "properties": {
        "reference_kind": { "const": "project_artifact" }, "owner_module": { "const": "project" },
        "project_id": { "$ref": "#/$defs/platform_identifier" }, "artifact_id": { "$ref": "#/$defs/platform_identifier" },
        "artifact_version": { "type": "integer", "minimum": 1 }, "title": { "$ref": "#/$defs/title" },
        "lifecycle": { "const": "active" }, "project_revision": { "type": "integer", "minimum": 1 },
        "workspace_revision": { "type": "integer", "minimum": 1 },
        "artifact_kind": { "enum": ["dataset", "notebook", "code", "environment", "result", "reflection", "supporting_file"] },
        "logical_path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*\\u0000).+$" },
        "media_type": { "enum": ["application/octet-stream", "application/json", "application/pdf", "application/x-ipynb+json", "text/csv", "text/markdown", "text/plain", "text/x-python"] },
        "inspection_mode": { "enum": ["metadata_only", "plain_text"] },
        "byte_count": { "type": "integer", "minimum": 0, "maximum": 10485760 },
        "content_digest": { "$ref": "#/$defs/digest" }, "created_at": { "$ref": "#/$defs/utc_time" },
        "destination": { "type": "string", "pattern": "^/projects/[a-z0-9][a-z0-9._-]{0,127}#artifact-[a-z0-9][a-z0-9._-]{0,127}-v[1-9][0-9]*$" },
        "target_status": { "const": "available" }, "validated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "reference": { "oneOf": [{ "$ref": "#/$defs/learning_opportunity" }, { "$ref": "#/$defs/placed_lesson" }, { "$ref": "#/$defs/project_workspace" }, { "$ref": "#/$defs/project_snapshot" }, { "$ref": "#/$defs/project_artifact" }] },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "record_id", "title", "body", "target", "archived", "created_at", "updated_at"],
      "properties": {
        "record_kind": { "const": "note" },
        "record_id": { "$ref": "#/$defs/platform_identifier" },
        "title": { "$ref": "#/$defs/learner_title" },
        "body": { "$ref": "#/$defs/note_body" },
        "target": { "$ref": "#/$defs/reference" },
        "archived": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/utc_time" },
        "updated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "bookmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "record_id", "target", "label", "archived", "created_at", "updated_at"],
      "properties": {
        "record_kind": { "const": "bookmark" },
        "record_id": { "$ref": "#/$defs/platform_identifier" },
        "target": { "$ref": "#/$defs/reference" },
        "label": { "type": ["string", "null"], "maxLength": 120, "pattern": "^[^\\u0000]*$" },
        "archived": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/utc_time" },
        "updated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "record": { "oneOf": [{ "$ref": "#/$defs/note" }, { "$ref": "#/$defs/bookmark" }] },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection_id", "title", "member_record_ids", "created_at", "updated_at"],
      "properties": {
        "collection_id": { "$ref": "#/$defs/platform_identifier" },
        "title": { "$ref": "#/$defs/learner_title" },
        "member_record_ids": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/platform_identifier" } },
        "created_at": { "$ref": "#/$defs/utc_time" },
        "updated_at": { "$ref": "#/$defs/utc_time" }
      }
    }
  }
}
