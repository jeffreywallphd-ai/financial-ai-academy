{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.local/contracts/learning/personal-workspace/v1/workspace.schema.json",
  "title": "Personal Workspace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "learner_id", "revision", "records", "collections", "created_at", "updated_at", "workspace_digest"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "workspace_id": { "$ref": "#/$defs/identifier" },
    "learner_id": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "records": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/record" } },
    "collections": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/collection" } },
    "created_at": { "$ref": "#/$defs/utc_time" },
    "updated_at": { "$ref": "#/$defs/utc_time" },
    "workspace_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc_time": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\u0000]*$" },
    "learner_title": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000]*$" },
    "note_body": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "^[^\\u0000]*$" },
    "destination": { "type": "string", "pattern": "^/learn/placements/[a-z0-9][a-z0-9._-]{2,63}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published_by", "published_at", "content_reviewed_on", "educational_use_notice"],
      "properties": {
        "published_by": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000]*$" },
        "published_at": { "$ref": "#/$defs/utc_time" },
        "content_reviewed_on": { "type": "string", "format": "date" },
        "educational_use_notice": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000]*$" }
      }
    },
    "learning_opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_kind", "owner_module", "opportunity_id", "placement_id", "package_id", "package_version", "package_digest", "source_fingerprint", "title", "destination", "target_status", "provenance", "validated_at"],
      "properties": {
        "reference_kind": { "const": "learning_opportunity" },
        "owner_module": { "const": "curriculum" },
        "opportunity_id": { "$ref": "#/$defs/identifier" },
        "placement_id": { "$ref": "#/$defs/identifier" },
        "package_id": { "$ref": "#/$defs/identifier" },
        "package_version": { "$ref": "#/$defs/version" },
        "package_digest": { "$ref": "#/$defs/digest" },
        "source_fingerprint": { "$ref": "#/$defs/digest" },
        "title": { "$ref": "#/$defs/title" },
        "destination": { "$ref": "#/$defs/destination" },
        "target_status": { "const": "available" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "validated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "placed_lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_kind", "owner_module", "placement_id", "package_id", "package_version", "package_digest", "title", "destination", "target_status", "provenance", "validated_at"],
      "properties": {
        "reference_kind": { "const": "placed_lesson" },
        "owner_module": { "const": "curriculum" },
        "placement_id": { "$ref": "#/$defs/identifier" },
        "package_id": { "$ref": "#/$defs/identifier" },
        "package_version": { "$ref": "#/$defs/version" },
        "package_digest": { "$ref": "#/$defs/digest" },
        "title": { "$ref": "#/$defs/title" },
        "destination": { "$ref": "#/$defs/destination" },
        "target_status": { "const": "available" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "validated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "reference": { "oneOf": [{ "$ref": "#/$defs/learning_opportunity" }, { "$ref": "#/$defs/placed_lesson" }] },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "record_id", "title", "body", "target", "archived", "created_at", "updated_at"],
      "properties": {
        "record_kind": { "const": "note" },
        "record_id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/learner_title" },
        "body": { "$ref": "#/$defs/note_body" },
        "target": { "$ref": "#/$defs/reference" },
        "archived": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/utc_time" },
        "updated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "bookmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "record_id", "target", "label", "archived", "created_at", "updated_at"],
      "properties": {
        "record_kind": { "const": "bookmark" },
        "record_id": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/reference" },
        "label": { "type": ["string", "null"], "maxLength": 120, "pattern": "^[^\\u0000]*$" },
        "archived": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/utc_time" },
        "updated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "record": { "oneOf": [{ "$ref": "#/$defs/note" }, { "$ref": "#/$defs/bookmark" }] },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection_id", "title", "member_record_ids", "created_at", "updated_at"],
      "properties": {
        "collection_id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/learner_title" },
        "member_record_ids": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "created_at": { "$ref": "#/$defs/utc_time" },
        "updated_at": { "$ref": "#/$defs/utc_time" }
      }
    }
  }
}
