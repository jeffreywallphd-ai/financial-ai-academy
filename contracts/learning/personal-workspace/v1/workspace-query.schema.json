{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.local/contracts/learning/personal-workspace/v1/workspace-query.schema.json",
  "title": "Personal Workspace Record Query v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "text": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\u0000]*$" },
    "record_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["note", "bookmark"] }
    },
    "owner_modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["curriculum", "project"] }
    },
    "reference_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["learning_opportunity", "placed_lesson", "project_workspace", "project_snapshot", "project_artifact"] }
    },
    "target_statuses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["available", "stale", "unavailable"] }
    },
    "archived": { "type": "boolean" },
    "collection_id": { "$ref": "#/$defs/platform_identifier" },
    "sort": { "enum": ["workspace_order", "updated_desc", "updated_asc", "title_asc", "source_asc"] },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "cursor": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$" }
  },
  "$defs": {
    "platform_identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
  }
}
