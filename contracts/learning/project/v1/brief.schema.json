{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/project/v1/brief.schema.json",
  "title": "Approved learning project brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_digest", "brief"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "brief_digest": {"$ref": "#/$defs/digest"},
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief_id", "brief_version", "title", "purpose", "milestones", "source_references"],
      "properties": {
        "brief_id": {"$ref": "#/$defs/id"},
        "brief_version": {"$ref": "#/$defs/semanticVersion"},
        "title": {"$ref": "#/$defs/title"},
        "purpose": {"$ref": "#/$defs/purpose"},
        "milestones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/milestone"}
        },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/sourceReference"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "maxLength": 64},
    "plainText": {"type": "string", "minLength": 1, "pattern": "^[^<>&\\u0000-\\u001f\\u007f]+$"},
    "title": {"allOf": [{"$ref": "#/$defs/plainText"}, {"maxLength": 120}]},
    "purpose": {"allOf": [{"$ref": "#/$defs/plainText"}, {"maxLength": 2000}]},
    "description": {"allOf": [{"$ref": "#/$defs/plainText"}, {"maxLength": 1000}]},
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["milestone_id", "description"],
      "properties": {
        "milestone_id": {"$ref": "#/$defs/id"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "resource_version", "resource_digest", "title"],
      "properties": {
        "resource_id": {"$ref": "#/$defs/id"},
        "resource_version": {"$ref": "#/$defs/semanticVersion"},
        "resource_digest": {"$ref": "#/$defs/digest"},
        "title": {"$ref": "#/$defs/title"}
      }
    }
  }
}
