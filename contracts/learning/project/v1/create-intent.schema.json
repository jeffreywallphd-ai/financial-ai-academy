{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/project/v1/create-intent.schema.json",
  "title": "Project create intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idempotency_key", "title", "charter", "origin"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "title": {"$ref": "#/$defs/title"},
    "charter": {"$ref": "#/$defs/charter"},
    "origin": {"oneOf": [{"$ref": "#/$defs/independentOrigin"}, {"$ref": "#/$defs/learningOrigin"}]}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "maxLength": 64},
    "plainText": {"type": "string", "minLength": 1, "pattern": "^[^<>&\\u0000-\\u001f\\u007f]+$"},
    "title": {"allOf": [{"$ref": "#/$defs/plainText"}, {"maxLength": 120}]},
    "charter": {"allOf": [{"$ref": "#/$defs/plainText"}, {"maxLength": 4000}]},
    "purpose": {"allOf": [{"$ref": "#/$defs/plainText"}, {"maxLength": 2000}]},
    "independentOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_type"],
      "properties": {"origin_type": {"const": "independent"}}
    },
    "learningOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_type", "project_brief_schema_version", "package_id", "package_version", "package_digest",
        "brief_id", "brief_version", "brief_digest", "curriculum_id", "curriculum_version", "curriculum_digest",
        "placement_id", "placement_version", "placement_digest", "brief_title", "brief_purpose"
      ],
      "properties": {
        "origin_type": {"const": "learning"},
        "project_brief_schema_version": {"const": "1.0.0"},
        "package_id": {"$ref": "#/$defs/id"},
        "package_version": {"$ref": "#/$defs/semanticVersion"},
        "package_digest": {"$ref": "#/$defs/digest"},
        "brief_id": {"$ref": "#/$defs/id"},
        "brief_version": {"$ref": "#/$defs/semanticVersion"},
        "brief_digest": {"$ref": "#/$defs/digest"},
        "curriculum_id": {"$ref": "#/$defs/id"},
        "curriculum_version": {"$ref": "#/$defs/semanticVersion"},
        "curriculum_digest": {"$ref": "#/$defs/digest"},
        "placement_id": {"$ref": "#/$defs/id"},
        "placement_version": {"$ref": "#/$defs/semanticVersion"},
        "placement_digest": {"$ref": "#/$defs/digest"},
        "brief_title": {"$ref": "#/$defs/title"},
        "brief_purpose": {"$ref": "#/$defs/purpose"}
      }
    }
  }
}
