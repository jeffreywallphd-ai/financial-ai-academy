{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.local/contracts/learning/project/v1/evidence-export.schema.json",
  "title": "Project Evidence Export Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_id", "export_digest", "export", "generated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "export_id": { "$ref": "#/$defs/identifier" },
    "export_digest": { "$ref": "#/$defs/digest" },
    "export": { "$ref": "#/$defs/export_material" },
    "generated_at": { "$ref": "#/$defs/utc_time" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc_time": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "safe_text": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "^[^<>\\u0000]*$" },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note_id", "note_version", "title", "body", "created_at", "updated_at"],
      "properties": {
        "note_id": { "$ref": "#/$defs/identifier" },
        "note_version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^<>\\u0000]*$" },
        "body": { "type": "string", "minLength": 1, "maxLength": 20000, "pattern": "^[^\\u0000]*$" },
        "created_at": { "$ref": "#/$defs/utc_time" },
        "updated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "reference_version", "title", "url", "source_name", "created_at", "updated_at"],
      "properties": {
        "reference_id": { "$ref": "#/$defs/identifier" },
        "reference_version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^<>\\u0000]*$" },
        "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" },
        "source_name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^<>\\u0000]*$" },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^<>\\u0000]*$" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "license": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^<>\\u0000]*$" },
        "use_constraints": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^<>\\u0000]*$" },
        "created_at": { "$ref": "#/$defs/utc_time" },
        "updated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_title"],
      "properties": {
        "source_type": { "enum": ["learner_created", "supplied", "external"] },
        "source_title": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^<>\\u0000]*$" },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^<>\\u0000]*$" },
        "source_url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "license": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^<>\\u0000]*$" },
        "use_constraints": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^<>\\u0000]*$" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^<>\\u0000]*$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^<>\\u0000]*$" },
        "dependency_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "artifact_kind", "logical_path", "media_type", "inspection_mode", "byte_count", "content_digest", "provenance", "assumptions", "created_at"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "artifact_version": { "type": "integer", "minimum": 1 },
        "artifact_kind": { "enum": ["dataset", "notebook", "code", "environment", "result", "reflection", "supporting_file"] },
        "logical_path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*\\u0000).+$" },
        "media_type": { "enum": ["application/octet-stream", "application/json", "application/pdf", "application/x-ipynb+json", "text/csv", "text/markdown", "text/plain", "text/x-python"] },
        "inspection_mode": { "enum": ["metadata_only", "plain_text"] },
        "byte_count": { "type": "integer", "minimum": 0, "maximum": 10485760 },
        "content_digest": { "$ref": "#/$defs/digest" },
        "result_classification": { "enum": ["observed", "calculated", "simulated", "predicted", "generated", "narrative"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "environment": { "$ref": "#/$defs/environment" },
        "assumptions": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/safe_text" } },
        "created_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "domain_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_id", "link_type", "owner_module", "resource_type", "resource_id", "owner_reference_digest", "target_status", "provenance", "validated_at", "created_at"],
      "properties": {
        "link_id": { "$ref": "#/$defs/identifier" },
        "link_type": { "enum": ["context", "input", "comparison", "output"] },
        "owner_module": { "$ref": "#/$defs/identifier" },
        "resource_type": { "$ref": "#/$defs/identifier" },
        "resource_id": { "$ref": "#/$defs/identifier" },
        "resource_version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^<>\\u0000]*$" },
        "resource_as_of": { "$ref": "#/$defs/utc_time" },
        "owner_reference_digest": { "$ref": "#/$defs/digest" },
        "target_status": { "const": "available" },
        "provenance": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^<>\\u0000]*$" },
        "validated_at": { "$ref": "#/$defs/utc_time" },
        "created_at": { "$ref": "#/$defs/utc_time" }
      },
      "anyOf": [
        { "required": ["resource_version"] },
        { "required": ["resource_as_of"] }
      ]
    },
    "workspace_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project_id", "learner_id", "workspace_revision", "notes", "references", "artifacts", "domain_links", "created_at", "updated_at"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "project_id": { "$ref": "#/$defs/identifier" },
        "learner_id": { "$ref": "#/$defs/identifier" },
        "workspace_revision": { "type": "integer", "minimum": 1 },
        "notes": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/note" } },
        "references": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/reference" } },
        "artifacts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/artifact" } },
        "domain_links": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/domain_link" } },
        "created_at": { "$ref": "#/$defs/utc_time" },
        "updated_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "version_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_version", "record_digest"],
      "properties": {
        "record_id": { "$ref": "#/$defs/identifier" },
        "record_version": { "type": "integer", "minimum": 1 },
        "record_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "manifest_digest", "content_digest", "byte_count"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "artifact_version": { "type": "integer", "minimum": 1 },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "byte_count": { "type": "integer", "minimum": 0, "maximum": 10485760 }
      }
    },
    "link_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_id", "record_digest", "owner_reference_digest"],
      "properties": {
        "link_id": { "$ref": "#/$defs/identifier" },
        "record_digest": { "$ref": "#/$defs/digest" },
        "owner_reference_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "snapshot_material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "learner_id", "project_revision", "project_shell_digest", "workspace_revision", "workspace_created_at", "workspace_updated_at", "notes", "references", "artifacts", "domain_links"],
      "properties": {
        "project_id": { "$ref": "#/$defs/identifier" },
        "learner_id": { "$ref": "#/$defs/identifier" },
        "project_revision": { "type": "integer", "minimum": 1 },
        "project_shell_digest": { "$ref": "#/$defs/digest" },
        "workspace_revision": { "type": "integer", "minimum": 1 },
        "workspace_created_at": { "$ref": "#/$defs/utc_time" },
        "workspace_updated_at": { "$ref": "#/$defs/utc_time" },
        "notes": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/version_ref" } },
        "references": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/version_ref" } },
        "artifacts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/artifact_ref" } },
        "domain_links": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/link_ref" } }
      }
    },
    "snapshot_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "snapshot_id", "snapshot_digest", "snapshot", "closed_at"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "snapshot_id": { "$ref": "#/$defs/identifier" },
        "snapshot_digest": { "$ref": "#/$defs/digest" },
        "snapshot": { "$ref": "#/$defs/snapshot_material" },
        "closed_at": { "$ref": "#/$defs/utc_time" }
      }
    },
    "artifact_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "manifest_digest", "logical_path", "media_type", "byte_count", "content_digest"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "artifact_version": { "type": "integer", "minimum": 1 },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "logical_path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*\\u0000).+$" },
        "media_type": { "enum": ["application/octet-stream", "application/json", "application/pdf", "application/x-ipynb+json", "text/csv", "text/markdown", "text/plain", "text/x-python"] },
        "byte_count": { "type": "integer", "minimum": 0, "maximum": 10485760 },
        "content_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "excluded_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "reason"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "artifact_version": { "type": "integer", "minimum": 1 },
        "reason": { "enum": ["source_use_restricted", "not_authorized", "content_unavailable"] }
      }
    },
    "export_material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "project_id", "snapshot_id", "snapshot_digest", "snapshot_record", "workspace_record", "artifact_files", "excluded_artifacts"],
      "properties": {
        "format": { "const": "project-evidence-manifest-v1" },
        "project_id": { "$ref": "#/$defs/identifier" },
        "snapshot_id": { "$ref": "#/$defs/identifier" },
        "snapshot_digest": { "$ref": "#/$defs/digest" },
        "snapshot_record": { "$ref": "#/$defs/snapshot_record" },
        "workspace_record": { "$ref": "#/$defs/workspace_record" },
        "artifact_files": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/artifact_file" } },
        "excluded_artifacts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/excluded_artifact" } }
      }
    }
  }
}
