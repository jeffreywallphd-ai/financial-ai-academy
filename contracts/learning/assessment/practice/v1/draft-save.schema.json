{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/assessment/practice/v1/draft-save.schema.json",
  "title": "Conditional practice draft save",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "placement_id", "package_id", "package_version", "package_digest", "definition_digest", "practice_id", "practice_version", "attempt_policy_id", "attempt_policy_version", "expected_revision", "responses"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "placement_id": {"$ref": "#/$defs/id"},
    "package_id": {"$ref": "#/$defs/id"},
    "package_version": {"$ref": "#/$defs/semanticVersion"},
    "package_digest": {"$ref": "#/$defs/digest"},
    "definition_digest": {"$ref": "#/$defs/digest"},
    "practice_id": {"$ref": "#/$defs/id"},
    "practice_version": {"const": "1.0.0"},
    "attempt_policy_id": {"const": "formative-retry"},
    "attempt_policy_version": {"const": "1.0.0"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "responses": {"$ref": "#/$defs/responses"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$", "maxLength": 40},
    "responses": {
      "type": "array",
      "maxItems": 20,
      "items": {"oneOf": [{"$ref": "#/$defs/singleResponse"}, {"$ref": "#/$defs/multipleResponse"}, {"$ref": "#/$defs/numericResponse"}]}
    },
    "responseBase": {
      "type": "object",
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "item_version": {"const": "1.0.0"},
        "scoring_policy_version": {"const": "1.0.0"}
      }
    },
    "singleResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "item_version", "item_type", "scoring_policy_id", "scoring_policy_version", "selected_option_id"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"}, "item_version": {"const": "1.0.0"}, "item_type": {"const": "single_select"},
        "scoring_policy_id": {"const": "single-select-exact-match"}, "scoring_policy_version": {"const": "1.0.0"}, "selected_option_id": {"$ref": "#/$defs/id"}
      }
    },
    "multipleResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "item_version", "item_type", "scoring_policy_id", "scoring_policy_version", "selected_option_ids"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"}, "item_version": {"const": "1.0.0"}, "item_type": {"const": "multiple_select"},
        "scoring_policy_id": {"const": "multiple-select-exact-set"}, "scoring_policy_version": {"const": "1.0.0"},
        "selected_option_ids": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "numericResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "item_version", "item_type", "scoring_policy_id", "scoring_policy_version", "entered_value"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"}, "item_version": {"const": "1.0.0"}, "item_type": {"const": "numeric_entry"},
        "scoring_policy_id": {"const": "numeric-exact-or-inclusive-range"}, "scoring_policy_version": {"const": "1.0.0"}, "entered_value": {"$ref": "#/$defs/decimal"}
      }
    }
  }
}
