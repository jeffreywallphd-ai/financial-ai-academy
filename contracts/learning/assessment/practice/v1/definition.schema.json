{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/assessment/practice/v1/definition.schema.json",
  "title": "Private deterministic practice definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "definition_digest", "practice"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "definition_digest": {"$ref": "#/$defs/digest"},
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["practice_id", "practice_version", "title", "purpose", "instructions", "attempt_policy", "source_references", "review_references", "items"],
      "properties": {
        "practice_id": {"$ref": "#/$defs/id"},
        "practice_version": {"const": "1.0.0"},
        "title": {"$ref": "#/$defs/label"},
        "purpose": {"$ref": "#/$defs/longText"},
        "instructions": {"$ref": "#/$defs/longText"},
        "attempt_policy": {"$ref": "#/$defs/attemptPolicy"},
        "source_references": {"$ref": "#/$defs/references"},
        "review_references": {"$ref": "#/$defs/references"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/singleSelect"},
              {"$ref": "#/$defs/multipleSelect"},
              {"$ref": "#/$defs/numericEntry"}
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "plainText": {"type": "string", "minLength": 1, "pattern": "^[^<>&\\u0000-\\u001f\\u007f]+$"},
    "label": {"allOf": [{"$ref": "#/$defs/plainText"}, {"maxLength": 160}]},
    "longText": {"allOf": [{"$ref": "#/$defs/plainText"}, {"maxLength": 600}]},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$", "maxLength": 40},
    "attemptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "max_attempts", "resume_allowed", "history_visible"],
      "properties": {
        "policy_id": {"const": "formative-retry"},
        "policy_version": {"const": "1.0.0"},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "resume_allowed": {"const": true},
        "history_visible": {"const": true}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "resource_version", "resource_digest", "title"],
      "properties": {
        "resource_id": {"$ref": "#/$defs/id"},
        "resource_version": {"$ref": "#/$defs/semanticVersion"},
        "resource_digest": {"$ref": "#/$defs/digest"},
        "title": {"$ref": "#/$defs/label"}
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/reference"}
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "label"],
      "properties": {
        "option_id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/label"}
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback_id", "text", "review_reference_ids"],
      "properties": {
        "feedback_id": {"$ref": "#/$defs/id"},
        "text": {"$ref": "#/$defs/longText"},
        "review_reference_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "feedbackPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correct", "incorrect"],
      "properties": {
        "correct": {"$ref": "#/$defs/feedback"},
        "incorrect": {"$ref": "#/$defs/feedback"}
      }
    },
    "singleSelect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "item_version", "item_type", "prompt", "scoring_policy", "options", "correct_option_id", "feedback"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "item_version": {"const": "1.0.0"},
        "item_type": {"const": "single_select"},
        "prompt": {"$ref": "#/$defs/longText"},
        "scoring_policy": {"$ref": "#/$defs/singlePolicy"},
        "options": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/option"}},
        "correct_option_id": {"$ref": "#/$defs/id"},
        "feedback": {"$ref": "#/$defs/feedbackPair"}
      }
    },
    "multipleSelect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "item_version", "item_type", "prompt", "scoring_policy", "options", "correct_option_ids", "feedback"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "item_version": {"const": "1.0.0"},
        "item_type": {"const": "multiple_select"},
        "prompt": {"$ref": "#/$defs/longText"},
        "scoring_policy": {"$ref": "#/$defs/multiplePolicy"},
        "options": {"type": "array", "minItems": 3, "maxItems": 12, "items": {"$ref": "#/$defs/option"}},
        "correct_option_ids": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "feedback": {"$ref": "#/$defs/feedbackPair"}
      }
    },
    "numericEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "item_version", "item_type", "prompt", "scoring_policy", "response", "answer", "feedback"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "item_version": {"const": "1.0.0"},
        "item_type": {"const": "numeric_entry"},
        "prompt": {"$ref": "#/$defs/longText"},
        "scoring_policy": {"$ref": "#/$defs/numericPolicy"},
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scale", "unit_label", "allow_negative"],
          "properties": {
            "scale": {"type": "integer", "minimum": 0, "maximum": 6},
            "unit_label": {"$ref": "#/$defs/label"},
            "allow_negative": {"type": "boolean"}
          }
        },
        "answer": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "value"],
              "properties": {"mode": {"const": "exact"}, "value": {"$ref": "#/$defs/decimal"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "lower", "upper"],
              "properties": {"mode": {"const": "inclusive_range"}, "lower": {"$ref": "#/$defs/decimal"}, "upper": {"$ref": "#/$defs/decimal"}}
            }
          ]
        },
        "feedback": {"$ref": "#/$defs/feedbackPair"}
      }
    },
    "singlePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "max_score"],
      "properties": {"policy_id": {"const": "single-select-exact-match"}, "policy_version": {"const": "1.0.0"}, "max_score": {"const": 1}}
    },
    "multiplePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "max_score"],
      "properties": {"policy_id": {"const": "multiple-select-exact-set"}, "policy_version": {"const": "1.0.0"}, "max_score": {"const": 1}}
    },
    "numericPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "max_score"],
      "properties": {"policy_id": {"const": "numeric-exact-or-inclusive-range"}, "policy_version": {"const": "1.0.0"}, "max_score": {"const": 1}}
    }
  }
}
