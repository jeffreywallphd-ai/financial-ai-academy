{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/assessment/practice/v1/draft.schema.json",
  "title": "Server-owned practice draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "placement_id", "package_id", "package_version", "package_digest", "definition_digest", "practice_id", "practice_version", "attempt_policy_id", "attempt_policy_version", "responses", "revision", "saved_at", "response_fingerprint"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "placement_id": {"$ref": "draft-save.schema.json#/$defs/id"},
    "package_id": {"$ref": "draft-save.schema.json#/$defs/id"},
    "package_version": {"$ref": "draft-save.schema.json#/$defs/semanticVersion"},
    "package_digest": {"$ref": "draft-save.schema.json#/$defs/digest"},
    "definition_digest": {"$ref": "draft-save.schema.json#/$defs/digest"},
    "practice_id": {"$ref": "draft-save.schema.json#/$defs/id"},
    "practice_version": {"const": "1.0.0"},
    "attempt_policy_id": {"const": "formative-retry"},
    "attempt_policy_version": {"const": "1.0.0"},
    "responses": {"$ref": "draft-save.schema.json#/$defs/responses"},
    "revision": {"type": "integer", "minimum": 1},
    "saved_at": {"$ref": "#/$defs/utcDateTime"},
    "response_fingerprint": {"$ref": "draft-save.schema.json#/$defs/digest"}
  },
  "$defs": {
    "utcDateTime": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"}
  }
}
