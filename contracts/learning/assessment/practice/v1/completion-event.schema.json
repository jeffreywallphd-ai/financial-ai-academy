{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/assessment/practice/v1/completion-event.schema.json",
  "title": "Practice completion event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "event_version", "owner", "occurred_at", "idempotency_key", "aggregate", "source", "payload"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"$ref": "#/$defs/uuid"},
    "event_type": {"const": "assessment.practice.completed"},
    "event_version": {"const": "1.0.0"},
    "owner": {"const": "assessment"},
    "occurred_at": {"$ref": "#/$defs/utcDateTime"},
    "idempotency_key": {"$ref": "#/$defs/uuid"},
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_type", "aggregate_id"],
      "properties": {"aggregate_type": {"const": "practice_attempt"}, "aggregate_id": {"$ref": "#/$defs/uuid"}}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id"],
      "properties": {"evidence_id": {"$ref": "#/$defs/uuid"}}
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learner_id", "submission_id", "placement_id", "package_id", "package_version", "package_digest", "definition_digest", "practice_id", "practice_version", "attempt_policy_id", "attempt_policy_version", "score", "max_score", "outcome", "item_scores", "completed_at"],
      "properties": {
        "learner_id": {"$ref": "#/$defs/uuid"},
        "submission_id": {"$ref": "#/$defs/uuid"},
        "placement_id": {"$ref": "#/$defs/id"},
        "package_id": {"$ref": "#/$defs/id"},
        "package_version": {"$ref": "#/$defs/semanticVersion"},
        "package_digest": {"$ref": "#/$defs/digest"},
        "definition_digest": {"$ref": "#/$defs/digest"},
        "practice_id": {"$ref": "#/$defs/id"},
        "practice_version": {"const": "1.0.0"},
        "attempt_policy_id": {"const": "formative-retry"},
        "attempt_policy_version": {"const": "1.0.0"},
        "score": {"type": "integer", "minimum": 0, "maximum": 20},
        "max_score": {"type": "integer", "minimum": 1, "maximum": 20},
        "outcome": {"enum": ["all_correct", "review_needed"]},
        "item_scores": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/itemScore"}},
        "completed_at": {"$ref": "#/$defs/utcDateTime"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "uuid": {"type": "string", "format": "uuid"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "utcDateTime": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "itemScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "item_version", "item_type", "scoring_policy_id", "scoring_policy_version", "score", "max_score"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "item_version": {"const": "1.0.0"},
        "item_type": {"enum": ["single_select", "multiple_select", "numeric_entry"]},
        "scoring_policy_id": {"enum": ["single-select-exact-match", "multiple-select-exact-set", "numeric-exact-or-inclusive-range"]},
        "scoring_policy_version": {"const": "1.0.0"},
        "score": {"type": "integer", "minimum": 0, "maximum": 1},
        "max_score": {"const": 1}
      }
    }
  }
}
