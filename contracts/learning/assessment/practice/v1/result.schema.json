{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/assessment/practice/v1/result.schema.json",
  "title": "Deterministic whole-practice result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "evidence_id", "learner_id", "submission_id", "request_fingerprint", "placement_id", "package_id", "package_version", "package_digest", "definition_digest", "practice_id", "practice_version", "attempt_policy_id", "attempt_policy_version", "score", "max_score", "outcome", "review_reference_ids", "item_results", "submitted_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "attempt_id": {"$ref": "#/$defs/uuid"},
    "evidence_id": {"$ref": "#/$defs/uuid"},
    "learner_id": {"$ref": "#/$defs/uuid"},
    "submission_id": {"$ref": "#/$defs/uuid"},
    "request_fingerprint": {"$ref": "#/$defs/digest"},
    "placement_id": {"$ref": "#/$defs/id"},
    "package_id": {"$ref": "#/$defs/id"},
    "package_version": {"$ref": "#/$defs/semanticVersion"},
    "package_digest": {"$ref": "#/$defs/digest"},
    "definition_digest": {"$ref": "#/$defs/digest"},
    "practice_id": {"$ref": "#/$defs/id"},
    "practice_version": {"const": "1.0.0"},
    "attempt_policy_id": {"const": "formative-retry"},
    "attempt_policy_version": {"const": "1.0.0"},
    "score": {"type": "integer", "minimum": 0, "maximum": 20},
    "max_score": {"type": "integer", "minimum": 1, "maximum": 20},
    "outcome": {"enum": ["all_correct", "review_needed"]},
    "review_reference_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "item_results": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/itemResult"}},
    "submitted_at": {"$ref": "#/$defs/utcDateTime"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "uuid": {"type": "string", "format": "uuid"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "utcDateTime": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "plainText": {"type": "string", "minLength": 1, "pattern": "^[^<>&\\u0000-\\u001f\\u007f]+$"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$", "maxLength": 40},
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback_id", "text", "review_reference_ids"],
      "properties": {
        "feedback_id": {"$ref": "#/$defs/id"},
        "text": {"allOf": [{"$ref": "#/$defs/plainText"}, {"maxLength": 600}]},
        "review_reference_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "singleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "item_version", "item_type", "scoring_policy_id", "scoring_policy_version", "selected_option_id", "score", "max_score", "correct", "feedback"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"}, "item_version": {"const": "1.0.0"}, "item_type": {"const": "single_select"},
        "scoring_policy_id": {"const": "single-select-exact-match"}, "scoring_policy_version": {"const": "1.0.0"},
        "selected_option_id": {"$ref": "#/$defs/id"}, "score": {"type": "integer", "minimum": 0, "maximum": 1}, "max_score": {"const": 1}, "correct": {"type": "boolean"}, "feedback": {"$ref": "#/$defs/feedback"}
      }
    },
    "multipleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "item_version", "item_type", "scoring_policy_id", "scoring_policy_version", "selected_option_ids", "score", "max_score", "correct", "feedback"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"}, "item_version": {"const": "1.0.0"}, "item_type": {"const": "multiple_select"},
        "scoring_policy_id": {"const": "multiple-select-exact-set"}, "scoring_policy_version": {"const": "1.0.0"},
        "selected_option_ids": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "score": {"type": "integer", "minimum": 0, "maximum": 1}, "max_score": {"const": 1}, "correct": {"type": "boolean"}, "feedback": {"$ref": "#/$defs/feedback"}
      }
    },
    "numericResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "item_version", "item_type", "scoring_policy_id", "scoring_policy_version", "entered_value", "score", "max_score", "correct", "feedback"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"}, "item_version": {"const": "1.0.0"}, "item_type": {"const": "numeric_entry"},
        "scoring_policy_id": {"const": "numeric-exact-or-inclusive-range"}, "scoring_policy_version": {"const": "1.0.0"},
        "entered_value": {"$ref": "#/$defs/decimal"}, "score": {"type": "integer", "minimum": 0, "maximum": 1}, "max_score": {"const": 1}, "correct": {"type": "boolean"}, "feedback": {"$ref": "#/$defs/feedback"}
      }
    },
    "itemResult": {"oneOf": [{"$ref": "#/$defs/singleResult"}, {"$ref": "#/$defs/multipleResult"}, {"$ref": "#/$defs/numericResult"}]}
  }
}
