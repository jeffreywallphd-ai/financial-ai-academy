{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.local/contracts/learning/assessment/project/v1/evidence.schema.json",
  "title": "Assessment Project Completion Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "learner_id", "submission_id", "project_id", "snapshot_id", "snapshot_digest", "brief_id", "brief_version", "brief_digest", "placement_id", "placement_version", "placement_digest", "policy_id", "policy_version", "milestone_evidence", "milestone_ids", "request_fingerprint", "occurrence", "accepted_sequence", "submitted_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "evidence_id": { "$ref": "#/$defs/identifier" }, "learner_id": { "$ref": "#/$defs/identifier" }, "submission_id": { "$ref": "#/$defs/identifier" },
    "project_id": { "$ref": "#/$defs/identifier" }, "snapshot_id": { "$ref": "#/$defs/identifier" }, "snapshot_digest": { "$ref": "#/$defs/digest" },
    "brief_id": { "$ref": "#/$defs/identifier" }, "brief_version": { "$ref": "#/$defs/version" }, "brief_digest": { "$ref": "#/$defs/digest" },
    "placement_id": { "$ref": "#/$defs/identifier" }, "placement_version": { "$ref": "#/$defs/version" }, "placement_digest": { "$ref": "#/$defs/digest" },
    "policy_id": { "const": "assessment-project-closure" }, "policy_version": { "const": "1.0.0" },
    "milestone_evidence": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/mapping" } },
    "milestone_ids": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/identifier" } },
    "request_fingerprint": { "$ref": "#/$defs/digest" }, "occurrence": { "type": "integer", "minimum": 1 },
    "accepted_sequence": { "type": "integer", "minimum": 1 }, "submitted_at": { "$ref": "#/$defs/utc_time" },
    "supersedes_submission_id": { "$ref": "#/$defs/identifier" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "utc_time": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "versioned_resource": { "type": "object", "additionalProperties": false, "required": ["resource_kind", "resource_id", "resource_version", "record_digest"], "properties": { "resource_kind": { "enum": ["note", "source"] }, "resource_id": { "$ref": "#/$defs/identifier" }, "resource_version": { "type": "integer", "minimum": 1 }, "record_digest": { "$ref": "#/$defs/digest" } } },
    "artifact_resource": { "type": "object", "additionalProperties": false, "required": ["resource_kind", "resource_id", "resource_version", "record_digest", "content_digest", "byte_count"], "properties": { "resource_kind": { "const": "artifact" }, "resource_id": { "$ref": "#/$defs/identifier" }, "resource_version": { "type": "integer", "minimum": 1 }, "record_digest": { "$ref": "#/$defs/digest" }, "content_digest": { "$ref": "#/$defs/digest" }, "byte_count": { "type": "integer", "minimum": 0, "maximum": 10485760 } } },
    "domain_resource": { "type": "object", "additionalProperties": false, "required": ["resource_kind", "resource_id", "record_digest", "owner_reference_digest"], "properties": { "resource_kind": { "const": "domain_resource" }, "resource_id": { "$ref": "#/$defs/identifier" }, "resource_version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^<>\\u0000]*$" }, "resource_as_of": { "$ref": "#/$defs/utc_time" }, "record_digest": { "$ref": "#/$defs/digest" }, "owner_reference_digest": { "$ref": "#/$defs/digest" } }, "oneOf": [{ "required": ["resource_version"] }, { "required": ["resource_as_of"] }] },
    "resource": { "oneOf": [{ "$ref": "#/$defs/versioned_resource" }, { "$ref": "#/$defs/artifact_resource" }, { "$ref": "#/$defs/domain_resource" }] },
    "mapping": { "type": "object", "additionalProperties": false, "required": ["milestone_id", "resources"], "properties": { "milestone_id": { "$ref": "#/$defs/identifier" }, "resources": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/resource" } } } }
  }
}
