{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.local/contracts/learning/assessment/project/v1/completion-event.schema.json",
  "title": "Assessment Project Completion Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "event_version", "occurred_at", "payload"],
  "properties": {
    "schema_version": { "const": "1.0.0" }, "event_id": { "$ref": "#/$defs/identifier" },
    "event_type": { "const": "assessment.project.completed" }, "event_version": { "const": "1.0.0" },
    "occurred_at": { "$ref": "#/$defs/utc_time" }, "payload": { "$ref": "#/$defs/payload" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "utc_time": { "type": "string", "minLength": 20, "maxLength": 27, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$" },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "submission_id", "project_id", "snapshot_id", "snapshot_digest", "brief_id", "brief_version", "brief_digest", "placement_id", "placement_version", "placement_digest", "policy_id", "policy_version", "milestone_ids", "request_fingerprint", "occurrence", "submitted_at"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/identifier" }, "submission_id": { "$ref": "#/$defs/identifier" }, "project_id": { "$ref": "#/$defs/identifier" },
        "snapshot_id": { "$ref": "#/$defs/identifier" }, "snapshot_digest": { "$ref": "#/$defs/digest" },
        "brief_id": { "$ref": "#/$defs/identifier" }, "brief_version": { "$ref": "#/$defs/version" }, "brief_digest": { "$ref": "#/$defs/digest" },
        "placement_id": { "$ref": "#/$defs/identifier" }, "placement_version": { "$ref": "#/$defs/version" }, "placement_digest": { "$ref": "#/$defs/digest" },
        "policy_id": { "const": "assessment-project-closure" }, "policy_version": { "const": "1.0.0" },
        "milestone_ids": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/identifier" } },
        "request_fingerprint": { "$ref": "#/$defs/digest" }, "occurrence": { "type": "integer", "minimum": 1 },
        "submitted_at": { "$ref": "#/$defs/utc_time" }, "supersedes_submission_id": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
