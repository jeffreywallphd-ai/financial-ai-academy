{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/lesson-package/v1/assessment-file.schema.json",
  "title": "Opaque Assessment-owned file reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "schema_version", "path", "media_type", "size_bytes", "sha256"],
  "properties": {
    "assessment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "schema_version": {"const": "1.0.0"},
    "path": {"type": "string", "minLength": 1, "maxLength": 240},
    "media_type": {"const": "application/json"},
    "size_bytes": {"type": "integer", "minimum": 2, "maximum": 8388608},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
