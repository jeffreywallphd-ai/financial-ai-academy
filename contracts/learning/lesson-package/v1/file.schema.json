{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/lesson-package/v1/file.schema.json",
  "title": "Declared package file",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "media_type", "size_bytes", "sha256"],
  "properties": {
    "path": {"type": "string", "minLength": 1, "maxLength": 240},
    "media_type": {"type": "string", "enum": ["text/markdown", "application/json", "image/png", "image/jpeg", "image/webp"]},
    "size_bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
