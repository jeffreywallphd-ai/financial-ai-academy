{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/lesson-package/v1/image-asset.schema.json",
  "title": "Passive image asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "path", "media_type", "size_bytes", "sha256", "alt_text"],
  "properties": {
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 240},
    "media_type": {"type": "string", "enum": ["image/png", "image/jpeg", "image/webp"]},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "alt_text": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}
