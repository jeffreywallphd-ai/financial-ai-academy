{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/lesson-package/v1/project-brief-file.schema.json",
  "title": "Project brief file declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["brief_id", "brief_version", "brief_digest", "schema_version", "path", "media_type", "size_bytes", "sha256"],
  "properties": {
    "brief_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "brief_version": {"type": "string", "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "brief_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_version": {"const": "1.0.0"},
    "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\\\]+$"},
    "media_type": {"const": "application/json"},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
