{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/learning/discovery/query/v1/applied-query.schema.json",
  "title": "Financial AI Academy applied learning opportunity query",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "prerequisite_query",
    "topics",
    "levels",
    "kinds",
    "availabilities",
    "minimum_minutes",
    "maximum_minutes",
    "sort",
    "page_size"
  ],
  "properties": {
    "query": {"$ref": "request.schema.json#/$defs/query_text"},
    "prerequisite_query": {"$ref": "request.schema.json#/$defs/query_text"},
    "topics": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,49}$"}
    },
    "levels": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["advanced", "intermediate", "introductory"]}
    },
    "kinds": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["course", "lab", "lesson", "project"]}
    },
    "availabilities": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["available", "planned", "unavailable"]}
    },
    "minimum_minutes": {"$ref": "request.schema.json#/$defs/minutes"},
    "maximum_minutes": {"$ref": "request.schema.json#/$defs/minutes"},
    "sort": {"$ref": "request.schema.json#/properties/sort"},
    "page_size": {"$ref": "request.schema.json#/properties/page_size"}
  }
}
