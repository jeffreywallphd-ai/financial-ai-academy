{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.local/contracts/learning/learner-assistance-preferences/v1/mutation-intent.schema.json",
  "title": "Learner assistance preference mutation intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idempotency_key", "expected_revision", "mutation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "mutation": {
      "oneOf": [
        {"$ref": "#/$defs/replacePreferences"},
        {"$ref": "#/$defs/resetProfile"}
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "replacePreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "assistance_mode"],
      "properties": {
        "operation": {"const": "replace_preferences"},
        "assistance_mode": {"enum": ["off", "on_request"]}
      }
    },
    "resetProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation"],
      "properties": {"operation": {"const": "reset_profile"}}
    }
  }
}
