{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.local/contracts/learning/adaptation/v1/activity-launch.schema.json",
  "title": "Adaptation Activity Launch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "curriculum_id",
    "curriculum_version",
    "graph_digest",
    "activity_id",
    "navigation_projection_digest",
    "evaluated_at",
    "placement_id",
    "package_id",
    "package_version",
    "package_digest",
    "destination"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "curriculum_id": { "$ref": "#/$defs/identifier" },
    "curriculum_version": { "$ref": "#/$defs/version" },
    "graph_digest": { "$ref": "#/$defs/digest" },
    "activity_id": { "$ref": "#/$defs/identifier" },
    "navigation_projection_digest": { "$ref": "#/$defs/digest" },
    "evaluated_at": { "$ref": "#/$defs/timestamp" },
    "placement_id": { "$ref": "#/$defs/identifier" },
    "package_id": { "$ref": "#/$defs/identifier" },
    "package_version": { "$ref": "#/$defs/semantic_version" },
    "package_digest": { "$ref": "#/$defs/digest" },
    "destination": {
      "type": "string",
      "pattern": "^/learn/placements/[a-z0-9][a-z0-9._:-]{0,127}$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
