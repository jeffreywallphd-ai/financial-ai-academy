{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.local/contracts/learning/adaptation/v1/source-facts.schema.json",
  "title": "Adaptation Navigation Source Facts v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "curriculum_id",
    "curriculum_version",
    "graph_digest",
    "policy_id",
    "policy_version",
    "evaluated_at",
    "activity_facts"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "curriculum_id": { "$ref": "#/$defs/identifier" },
    "curriculum_version": { "$ref": "#/$defs/version" },
    "graph_digest": { "$ref": "#/$defs/digest" },
    "policy_id": { "$ref": "#/$defs/identifier" },
    "policy_version": { "$ref": "#/$defs/version" },
    "evaluated_at": { "$ref": "#/$defs/timestamp" },
    "activity_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/activity_fact" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "activity_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "activity_source_state",
        "completion_state",
        "source_digest"
      ],
      "properties": {
        "activity_id": { "$ref": "#/$defs/identifier" },
        "activity_source_state": {
          "enum": ["available", "unavailable"]
        },
        "completion_state": {
          "enum": ["completed", "incomplete", "unavailable"]
        },
        "source_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
