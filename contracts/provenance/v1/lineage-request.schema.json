{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/provenance/v1/lineage-request.schema.json",
  "title": "Financial AI Academy lineage request v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "root_kind", "package_id", "package_version", "package_digest"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "root_kind": {"const": "published_lesson"},
        "package_id": {"$ref": "#/$defs/identifier"},
        "package_version": {"$ref": "#/$defs/version"},
        "package_digest": {"$ref": "#/$defs/digest"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "root_kind", "placement_id", "evidence_id", "occurrence"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "root_kind": {"const": "knowledge_check_completion"},
        "placement_id": {"$ref": "#/$defs/identifier"},
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "occurrence": {"type": "integer", "minimum": 1}
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\s._:/\\\\?#][^\\s/\\\\?#]{0,127}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,79}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
