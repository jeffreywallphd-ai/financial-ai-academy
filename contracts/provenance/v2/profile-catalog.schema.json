{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/provenance/v2/profile-catalog.schema.json",
  "title": "Financial AI Academy provenance profile catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "profiles"],
  "properties": {
    "catalog_version": {"const": "2.0.0"},
    "profiles": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "owner_module",
          "resource_kind",
          "allowed_provenance_labels",
          "allowed_source_relations",
          "identity_variants"
        ],
        "properties": {
          "profile": {"type": "string", "minLength": 1, "maxLength": 64},
          "owner_module": {"type": "string", "minLength": 1, "maxLength": 64},
          "resource_kind": {"type": "string", "minLength": 1, "maxLength": 64},
          "allowed_provenance_labels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"enum": ["observed", "calculated", "simulated", "predicted", "generated", "administrative"]}
          },
          "allowed_source_relations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {"enum": ["derived_from", "calculated_from", "used_dataset", "used_model", "executed_as", "simulated_from", "recommended_from", "governed_by", "recorded_as"]}
          },
          "identity_variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["variant_id", "identity_fields", "resource_id_strategy"],
              "properties": {
                "variant_id": {"type": "string", "minLength": 1, "maxLength": 32},
                "identity_fields": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 6,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "maxLength": 64}
                },
                "resource_id_strategy": {"enum": ["field", "identity_digest"]},
                "resource_id_field": {"type": "string", "minLength": 1, "maxLength": 64}
              },
              "allOf": [
                {
                  "if": {"properties": {"resource_id_strategy": {"const": "field"}}},
                  "then": {"required": ["resource_id_field"]},
                  "else": {"not": {"required": ["resource_id_field"]}}
                }
              ]
            }
          }
        }
      }
    }
  }
}
