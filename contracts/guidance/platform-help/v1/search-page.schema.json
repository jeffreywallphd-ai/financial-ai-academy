{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/guidance/platform-help/v1/search-page.schema.json",
  "title": "Financial AI Academy platform help search page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_digest",
    "query",
    "results",
    "next_cursor"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "corpus_digest": {"$ref": "#/$defs/digest"},
    "query": {"type": "string", "maxLength": 200},
    "topic_kind": {"$ref": "#/$defs/topicKind"},
    "results": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/result"}
    },
    "next_cursor": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 4096}
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "topicKind": {
      "enum": ["glossary", "help", "method", "limitation", "troubleshooting"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_id",
        "topic_version",
        "topic_kind",
        "title",
        "summary",
        "applicability",
        "publication",
        "source_references",
        "topic_digest"
      ],
      "properties": {
        "topic_id": {"$ref": "#/$defs/identifier"},
        "topic_version": {"$ref": "#/$defs/version"},
        "topic_kind": {"$ref": "#/$defs/topicKind"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "summary": {"type": "string", "minLength": 20, "maxLength": 500},
        "glossary_term": {"type": "string", "minLength": 1, "maxLength": 120},
        "applicability": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/applicability"}
        },
        "publication": {"$ref": "#/$defs/publication"},
        "source_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/sourceReference"}
        },
        "topic_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_key", "label"],
      "properties": {
        "scope_key": {"$ref": "#/$defs/identifier"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reviewed_on", "updated_at"],
      "properties": {
        "state": {"const": "approved"},
        "reviewed_on": {"type": "string", "format": "date"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "title", "area", "source_version", "content_fingerprint"],
      "properties": {
        "source_key": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "area": {"enum": ["product", "domain", "contract", "architecture", "risk", "method"]},
        "source_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "content_fingerprint": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
