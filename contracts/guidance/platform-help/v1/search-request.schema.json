{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/guidance/platform-help/v1/search-request.schema.json",
  "title": "Financial AI Academy platform help search request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query", "page_size"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "query": {"type": "string", "maxLength": 200},
    "topic_kind": {
      "enum": ["glossary", "help", "method", "limitation", "troubleshooting"]
    },
    "page_size": {"type": "integer", "minimum": 1, "maximum": 50},
    "cursor": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
