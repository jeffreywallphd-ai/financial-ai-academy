{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/guidance/platform-help/v1/topic.schema.json",
  "title": "Financial AI Academy platform help topic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topic_id",
    "topic_version",
    "topic_kind",
    "title",
    "summary",
    "keywords",
    "body",
    "applicability",
    "publication",
    "source_references",
    "related_topics",
    "topic_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "topic_id": {"$ref": "#/$defs/identifier"},
    "topic_version": {"$ref": "#/$defs/version"},
    "topic_kind": {"$ref": "#/$defs/topicKind"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "summary": {"type": "string", "minLength": 20, "maxLength": 500},
    "glossary_term": {"type": "string", "minLength": 1, "maxLength": 120},
    "keywords": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    },
    "body": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/bodyNode"}
    },
    "applicability": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/applicability"}
    },
    "publication": {"$ref": "#/$defs/publication"},
    "source_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/sourceReference"}
    },
    "related_topics": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/topicReference"}
    },
    "topic_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "topicKind": {
      "enum": ["glossary", "help", "method", "limitation", "troubleshooting"]
    },
    "bodyNode": {
      "oneOf": [
        {"$ref": "#/$defs/headingNode"},
        {"$ref": "#/$defs/paragraphNode"},
        {"$ref": "#/$defs/listNode"},
        {"$ref": "#/$defs/noteNode"},
        {"$ref": "#/$defs/topicReferenceNode"}
      ]
    },
    "headingNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_kind", "level", "text"],
      "properties": {
        "node_kind": {"const": "heading"},
        "level": {"type": "integer", "minimum": 2, "maximum": 4},
        "text": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "paragraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_kind", "text"],
      "properties": {
        "node_kind": {"const": "paragraph"},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "listNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_kind", "list_kind", "items"],
      "properties": {
        "node_kind": {"const": "list"},
        "list_kind": {"enum": ["ordered", "unordered"]},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "noteNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_kind", "note_kind", "text"],
      "properties": {
        "node_kind": {"const": "note"},
        "note_kind": {"enum": ["educational", "limitation", "warning"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "topicReferenceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_kind", "topic_id", "topic_version", "label"],
      "properties": {
        "node_kind": {"const": "topic_reference"},
        "topic_id": {"$ref": "#/$defs/identifier"},
        "topic_version": {"$ref": "#/$defs/version"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_key", "label"],
      "properties": {
        "scope_key": {"$ref": "#/$defs/identifier"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reviewed_on", "updated_at"],
      "properties": {
        "state": {"const": "approved"},
        "reviewed_on": {"type": "string", "format": "date"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "title", "area", "source_version", "content_fingerprint"],
      "properties": {
        "source_key": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "area": {"enum": ["product", "domain", "contract", "architecture", "risk", "method"]},
        "source_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "content_fingerprint": {"$ref": "#/$defs/digest"}
      }
    },
    "topicReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_id", "topic_version", "relationship"],
      "properties": {
        "topic_id": {"$ref": "#/$defs/identifier"},
        "topic_version": {"$ref": "#/$defs/version"},
        "relationship": {"enum": ["see_also", "prerequisite", "explains"]}
      }
    }
  }
}
