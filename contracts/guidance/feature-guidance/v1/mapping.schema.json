{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-ai-academy.org/contracts/guidance/feature-guidance/v1/mapping.schema.json",
  "title": "Financial AI Academy feature guidance mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "surface_key", "condition_key", "mapping_version",
    "guidance_id", "guidance_version", "publication", "source_references",
    "mapping_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "surface_key": {"$ref": "#/$defs/identifier"},
    "condition_key": {"$ref": "#/$defs/identifier"},
    "mapping_version": {"$ref": "#/$defs/version"},
    "guidance_id": {"$ref": "#/$defs/identifier"},
    "guidance_version": {"$ref": "#/$defs/version"},
    "publication": {"$ref": "#/$defs/publication"},
    "source_references": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {"$ref": "#/$defs/sourceReference"}
    },
    "mapping_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "reviewed_on", "updated_at"],
      "properties": {
        "state": {"const": "approved"},
        "reviewed_on": {"type": "string", "format": "date"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "sourceReference": {
      "type": "object", "additionalProperties": false,
      "required": ["source_key", "title", "area", "source_version", "content_fingerprint"],
      "properties": {
        "source_key": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "area": {"enum": ["product", "domain", "contract", "architecture", "risk", "method"]},
        "source_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "content_fingerprint": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
