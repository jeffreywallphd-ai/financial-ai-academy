{
  "name": "@financial-ai-academy/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": "10.8.2"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:full": "node ../../deployments/local/dev.mjs",
    "setup:dev": "node ../../deployments/local/setup-dev.mjs",
    "generate:api": "node scripts/generate-api-client.mjs",
    "lint": "oxlint --deny-warnings src tests vite.config.ts",
    "test": "node scripts/generate-api-client.mjs test && vitest --root ../.. --config apps/web/vite.config.ts --passWithNoTests",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "test:e2e": "playwright test --config tests/browser/approved-lesson.config.ts",
    "test:ui": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.1.1",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
